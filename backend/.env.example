# Runtime environment: development, test, or production.
APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this backend-only value private. Production requires at least 32 characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_HASHING_ALGORITHM=argon2

# Local SQLite is convenient for development. Use a PostgreSQL URL in production.
DATABASE_URL=sqlite:///./splitsnap.db

# Keep AI provider credentials on the backend only. No provider is configured yet.
AI_API_KEY=
AI_MODEL=

# PayPal Sandbox API origin; use credentials from your PayPal developer account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Allowed browser origin for the frontend.
FRONTEND_URL=http://localhost:3000

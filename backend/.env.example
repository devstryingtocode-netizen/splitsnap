# Runtime environment: development, test, or production.
APP_ENV=development

# Generate a unique value for deployed environments; never commit the real key.
SECRET_KEY=replace-with-a-long-random-value-before-production

# Local SQLite is convenient for development. Use a PostgreSQL URL in production.
DATABASE_URL=sqlite:///./splitsnap.db

# Temporary development-only session owner. Set to an existing users.id UUID.
DEVELOPMENT_OWNER_ID=

# Keep AI provider credentials on the backend only. No provider is configured yet.
AI_API_KEY=
AI_MODEL=

# PayPal Sandbox API origin; use credentials from your PayPal developer account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Allowed browser origin for the frontend.
FRONTEND_URL=http://localhost:3000

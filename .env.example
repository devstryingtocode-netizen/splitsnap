# Copy the relevant variables into frontend/.env.local and backend/.env.
# This file is a reference only; never put real credentials here.

# Frontend (public API origin only; never place private credentials here)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value-before-production
DATABASE_URL=sqlite:///./splitsnap.db
DEVELOPMENT_OWNER_ID=
AI_API_KEY=
AI_MODEL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
FRONTEND_URL=http://localhost:3000
